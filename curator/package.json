	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"docker": "docker build -t kangruixiang/curator:0.1.0 . && docker tag kangruixiang/curator:0.1.0 kangruixiang/curator:latest && docker push kangruixiang/curator:0.1.0 && docker push kangruixiang/curator:latest",
